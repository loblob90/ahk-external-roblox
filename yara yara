SetTransKey(hwnd) {
    DllCall("user32\SetLayeredWindowAttributes", "Ptr", hwnd, "UInt", 0x00FF00FF, "UInt", 0, "UInt", 1)
}

PositionOverlay(hwnd, x, y, w, h) {
    DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", 0
        , "Int", x, "Int", y, "Int", w, "Int", h, "UInt", 0x0010 | 0x0004)
}

OnNoErase(w, l, m, hwnd) {
    global HwndOverlay
    if (hwnd = HwndOverlay) {
        return 1
    }
}

OnOverlayPaint(w, l, m, hwnd) {
    global HwndOverlay, hBBdc, BBw, BBh
    if (hwnd != HwndOverlay || !hBBdc || BBw <= 0) {
        return
    }
    hdc := DllCall("user32\GetDC", "Ptr", hwnd, "Ptr")
    DllCall("gdi32\BitBlt", "Ptr", hdc, "Int", 0, "Int", 0, "Int", BBw, "Int", BBh
        , "Ptr", hBBdc, "Int", 0, "Int", 0, "UInt", 0x00CC0020)
    DllCall("user32\ReleaseDC", "Ptr", hwnd, "Ptr", hdc)
    DllCall("user32\ValidateRect", "Ptr", hwnd, "Ptr", 0)
    return 0
}

InitBackbuffer(w, h) {
    global
    if (hBBdc && w = BBw && h = BBh) {
        return
    }
    if (hBBdc) {
        DllCall("gdi32\DeleteObject", "Ptr", hBBbm, "Ptr")
        DllCall("gdi32\DeleteDC", "Ptr", hBBdc, "Ptr")
    }
    hdcS := DllCall("user32\GetDC", "Ptr", HwndOverlay, "Ptr")
    hBBdc := DllCall("gdi32\CreateCompatibleDC", "Ptr", hdcS, "Ptr")
    hBBbm := DllCall("gdi32\CreateCompatibleBitmap", "Ptr", hdcS, "Int", w, "Int", h, "Ptr")
    DllCall("user32\ReleaseDC", "Ptr", HwndOverlay, "Ptr", hdcS)
    DllCall("gdi32\SelectObject", "Ptr", hBBdc, "Ptr", hBBbm, "Ptr")
    DllCall("gdi32\SelectObject", "Ptr", hBBdc, "Ptr", hFont, "Ptr")
    FillRect(hBBdc, 0, 0, w, h, hBrushErase)
    BBw := w, BBh := h
}

GetClientRect(hwnd) {
    rc := Buffer(16, 0)
    DllCall("user32\GetClientRect", "Ptr", hwnd, "Ptr", rc)
    DllCall("user32\ClientToScreen", "Ptr", hwnd, "Ptr", rc)
    return {x: NumGet(rc, 0, "Int"), y: NumGet(rc, 4, "Int")
        , w: NumGet(rc, 8, "Int"), h: NumGet(rc, 12, "Int")}
}

FillRect(dc, x1, y1, x2, y2, brush) {
    global FillRectBuf
    NumPut("Int", Round(x1), FillRectBuf, 0)
    NumPut("Int", Round(y1), FillRectBuf, 4)
    NumPut("Int", Round(x2), FillRectBuf, 8)
    NumPut("Int", Round(y2), FillRectBuf, 12)
    DllCall("user32\FillRect", "Ptr", dc, "Ptr", FillRectBuf, "Ptr", brush)
}

DrawBox(dc, x1, y1, x2, y2, pen) {
    oldP := DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", pen, "Ptr")
    oldB := DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr"
        , DllCall("gdi32\GetStockObject", "Int", 5, "Ptr"), "Ptr")
    DllCall("gdi32\Rectangle", "Ptr", dc, "Int", Round(x1), "Int", Round(y1)
        , "Int", Round(x2), "Int", Round(y2))
    DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", oldB, "Ptr")
    DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", oldP, "Ptr")
}

DrawCornerBox(dc, x1, y1, x2, y2, pen) {
    x1 := Round(x1), y1 := Round(y1), x2 := Round(x2), y2 := Round(y2)
    cl := Max((x2 - x1) // 5, 4)
    cw := Max((y2 - y1) // 5, 4)
    old := DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", pen, "Ptr")
    DllCall("gdi32\MoveToEx", "Ptr", dc, "Int", x1, "Int", (y1 + cw), "Ptr", 0)
    DllCall("gdi32\LineTo", "Ptr", dc, "Int", x1, "Int", y1)
    DllCall("gdi32\LineTo", "Ptr", dc, "Int", (x1 + cl), "Int", y1)
    DllCall("gdi32\MoveToEx", "Ptr", dc, "Int", (x2 - cl), "Int", y1, "Ptr", 0)
    DllCall("gdi32\LineTo", "Ptr", dc, "Int", x2, "Int", y1)
    DllCall("gdi32\LineTo", "Ptr", dc, "Int", x2, "Int", (y1 + cw))
    DllCall("gdi32\MoveToEx", "Ptr", dc, "Int", x2, "Int", (y2 - cw), "Ptr", 0)
    DllCall("gdi32\LineTo", "Ptr", dc, "Int", x2, "Int", y2)
    DllCall("gdi32\LineTo", "Ptr", dc, "Int", (x2 - cl), "Int", y2)
    DllCall("gdi32\MoveToEx", "Ptr", dc, "Int", (x1 + cl), "Int", y2, "Ptr", 0)
    DllCall("gdi32\LineTo", "Ptr", dc, "Int", x1, "Int", y2)
    DllCall("gdi32\LineTo", "Ptr", dc, "Int", x1, "Int", (y2 - cw))
    DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", old, "Ptr")
}

DrawLine(dc, x1, y1, x2, y2, pen) {
    old := DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", pen, "Ptr")
    DllCall("gdi32\MoveToEx", "Ptr", dc, "Int", Round(x1), "Int", Round(y1), "Ptr", 0)
    DllCall("gdi32\LineTo", "Ptr", dc, "Int", Round(x2), "Int", Round(y2))
    DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", old, "Ptr")
}

DrawText(dc, text, x, y, color) {
    DllCall("gdi32\SetTextColor", "Ptr", dc, "UInt", color)
    DllCall("gdi32\SetBkMode", "Ptr", dc, "Int", 1)
    DllCall("gdi32\TextOutA", "Ptr", dc, "Int", Round(x), "Int", Round(y)
        , "AStr", text, "Int", StrLen(text))
}

; ----------------------------------------------------------------
;  Process memory
; ----------------------------------------------------------------
class RobloxMemory {
    __New(exeName) {
        this.hProcess := 0
        this.EnableDebugPrivilege()
        try pid := ProcessExist(exeName)
        if (!pid) {
            return
        }
        this.PID := pid
        this.hProcess := DllCall("OpenProcess", "UInt", 0x1F0FFF, "Int", 0, "UInt", pid, "Ptr")
        if (this.hProcess) {
            this.BaseAddress := this.GetModuleBase(exeName)
        }
    }

    __Delete() {
        if (this.hProcess && this.hProcess != -1) {
            DllCall("CloseHandle", "Ptr", this.hProcess)
        }
    }

    EnableDebugPrivilege() {
        hToken := 0
        DllCall("Advapi32\OpenProcessToken", "Ptr", -1, "UInt", 0x0020, "Ptr*", &hToken)
        la := Buffer(12, 0), luid := 0
        DllCall("Advapi32\LookupPrivilegeValue", "Ptr", 0, "Str", "SeDebugPrivilege", "Int64*", &luid)
        NumPut("Int64", luid, la, 0)
        NumPut("UInt", 2, la, 8)
        tp := Buffer(16, 0), NumPut("UInt", 1, tp, 0)
        DllCall("RtlMoveMemory", "Ptr", tp.ptr + 4, "Ptr", la.ptr, "UPtr", 12)
        DllCall("Advapi32\AdjustTokenPrivileges", "Ptr", hToken, "Int", 0
            , "Ptr", tp, "UInt", 0, "Ptr", 0, "Ptr", 0)
        DllCall("CloseHandle", "Ptr", hToken)
    }

    GetModuleBase(moduleName) {
        hSnap := DllCall("CreateToolhelp32Snapshot", "UInt", 0x00000018, "UInt", this.PID, "Ptr")
        if (hSnap = -1 || !hSnap) {
            return 0
        }
        sz := 1080
        me32 := Buffer(sz, 0)
        NumPut("UInt", sz, me32, 0)
        if (DllCall("Module32First", "Ptr", hSnap, "Ptr", me32)) {
            Loop {
                if (StrGet(me32.ptr + 48, 256, "CP0") = moduleName) {
                    modBase := NumGet(me32, 24, "Ptr")
                    DllCall("CloseHandle", "Ptr", hSnap)
                    return modBase
                }
            } Until !DllCall("Module32Next", "Ptr", hSnap, "Ptr", me32)
        }
        DllCall("CloseHandle", "Ptr", hSnap)
        return 0
    }

    Read(addr, type := "Ptr") {
        size := this.GetTypeSize(type)
        buf := Buffer(size, 0)
        DllCall("ReadProcessMemory", "Ptr", this.hProcess, "Ptr", addr, "Ptr", buf
            , "UPtr", size, "Ptr", 0)
        return NumGet(buf, 0, type)
    }

    Write(addr, buf, size) {
        return DllCall("WriteProcessMemory", "Ptr", this.hProcess, "Ptr", addr
            , "Ptr", buf, "UPtr", size, "Ptr", 0)
    }

    WriteValue(addr, val, type := "Float") {
        size := this.GetTypeSize(type)
        buf := Buffer(size, 0)
        NumPut(type, val, buf, 0)
        return DllCall("WriteProcessMemory", "Ptr", this.hProcess, "Ptr", addr
            , "Ptr", buf, "UPtr", size, "Ptr", 0)
    }

    ReadString(addr, size) {
        buf := Buffer(size + 1, 0)
        DllCall("ReadProcessMemory", "Ptr", this.hProcess, "Ptr", addr, "Ptr", buf
            , "UPtr", size, "Ptr", 0)
        s := StrGet(buf, size, "CP0")
        return RegExMatch(s, "[^\x20-\x7E]") ? "" : s
    }

    GetTypeSize(type) {
        if (type = "Float" || type = "UInt" || type = "Int") {
            return 4
        }
        if (type = "UChar" || type = "Char") {
            return 1
        }
        if (type = "UShort" || type = "Short") {
            return 2
        }
        return 8
    }
}
