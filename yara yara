; ----------------------------------------------------------------
;  Movement writes
; ----------------------------------------------------------------
RequireAttach() {
    global Attached, mem
    return (Attached && IsObject(mem) && mem.hProcess)
}

ApplyGravity() {
    global
    if (!RequireAttach() || !WorldPtr) {
        StatusText.Text := "⚠ Attach first"
        return
    }
    GravVal := EdtGrav.Text
    mem.WriteValue(WorldPtr + OFF.wGrav, Float(GravVal), "Float")
    mem.WriteValue(WorkspaceAddr + OFF.roGrav, Float(GravVal), "Float")
    GravActive := true
    StatusText.Text := "Gravity: " GravVal
}

ApplyWalkspeed() {
    global
    if (!RequireAttach()) {
        StatusText.Text := "⚠ Attach first"
        return
    }
    ResolveCamHumanoid()
    if (!CamHumanoid) {
        StatusText.Text := "⚠ No humanoid"
        return
    }
    SpeedVal := EdtSpeed.Text
    mem.WriteValue(CamHumanoid + OFF.walkspd, Float(SpeedVal), "Float")
    mem.WriteValue(CamHumanoid + OFF.walkchk, Float(SpeedVal), "Float")
    SpeedActive := true
    StatusText.Text := "Speed: " SpeedVal
}

ApplyJumpPower() {
    global
    if (!RequireAttach()) {
        StatusText.Text := "⚠ Attach first"
        return
    }
    ResolveCamHumanoid()
    if (!CamHumanoid) {
        StatusText.Text := "⚠ No humanoid"
        return
    }
    JumpVal := EdtJump.Text
    mem.WriteValue(CamHumanoid + OFF.jumppwr, Float(JumpVal), "Float")
    mem.WriteValue(CamHumanoid + OFF.useJmp, 1, "UChar")
    JumpActive := true
    StatusText.Text := "Jump: " JumpVal
}

; physics
ApplyPhysics() {
    global
    if (!RequireAttach() || !WorldPtr) {
        StatusText.Text := "⚠ Attach first"
        return
    }
    PhysVal := EdtPhys.Text
    steps := Float(PhysVal) * 4
    if (steps < 4) {
        steps := 4
    }
    mem.WriteValue(WorldPtr + OFF.wSteps, steps, "Float")
    PhysActive := true
    StatusText.Text := "Physics: " PhysVal " Hz"
}

