RenderFrame() {
    global
    if (!RequireAttach()) {
        SetTimer RenderFrame, 0
        Attached := false
        return
    }
    rbxHwnd := WinExist("ahk_exe RobloxPlayerBeta.exe")
    if (!rbxHwnd) {
        return
    }
    FrameTick++
    rc := GetClientRect(rbxHwnd)
    ScreenW := rc.w, ScreenH := rc.h
    if (rc.x != PrevOx || rc.y != PrevOy || rc.w != PrevCw || rc.h != PrevCh) {
        PositionOverlay(HwndOverlay, rc.x, rc.y, rc.w, rc.h)
        PrevOx := rc.x, PrevOy := rc.y, PrevCw := rc.w, PrevCh := rc.h
    }
    InitBackbuffer(rc.w, rc.h)
    ve := mem.Read(mem.BaseAddress + OFF.ve, "Ptr")
    if (ve) {
        VEAddr := ve
    }
    MatrixOK := false
    if (VEAddr) {
        MatrixOK := LoadViewMatrix(VEAddr)
    }
    if (!MatrixOK || ViewM.Length < 16 || Abs(ViewM[16]) < 0.0001) {
        return
    }
    if (Mod(FrameTick, 30) = 0) {
        RefreshWorldPointers()
    }
    if (ScanActive) {
        ProcessScanChunk()
    } else if ((A_TickCount - LastScanComplete) > 5000) {
        StartScan()
    }
    if (Mod(FrameTick, 15) = 0 || !LocalCharPtr) {
        ResolveLocalPlayer()
    } else if (LocalPrimPtr) {
        p := ReadPositionFast(LocalPrimPtr)
        if (IsObject(p)) {
            LocalPlayerPos := p
        } else {
            LocalPrimPtr := 0
        }
    }
    if (KeepAlive && Mod(FrameTick, 60) = 0) {
        MovementKeepAlive()
    }
    UpdateCombat()
    FillRect(hBBdc, 0, 0, rc.w, rc.h, hBrushErase)
    StatTotal := EntityCache.Length
    StatVisible := 0
    rbIdx := Mod(FrameTick // 3, 24) + 1
    rainbowPen := RainbowPens[rbIdx]
    if (OverlayEnabled) {
        DrawEntities(rainbowPen)
        DrawCombatHud(rainbowPen)
    }
    PresentOverlay(rc.w, rc.h)
    UpdatePanelLabels()
}

DrawEntities(rainbowPen) {
    global
    refreshHp := (Mod(FrameTick, 30) = 0)
    drawnCount := 0
    for ent in EntityCache {
        if (ent.char = LocalCharPtr) {
            continue
        }
        if (!ent.prim || !ent.hum || ent.hum < 0x10000) {
            continue
        }
        if (drawnCount >= MaxDrawEntities) {
            break
        }
        if (refreshHp) {
            ent.hp := mem.Read(ent.hum + OFF.hp, "Float")
            ent.maxhp := mem.Read(ent.hum + OFF.mhp, "Float")
        }
        if (ent.hp <= 0.01) {
            continue
        }
        pos := ReadPositionFast(ent.prim)
        if (!IsObject(pos)) {
            ent.prim := 0
            continue
        }
        if (!ProjectToScreen(pos[1], pos[2] - 3.0, pos[3], &sx1, &sy1)) {
            continue
        }
        if (!ProjectToScreen(pos[1], pos[2] + 3.0, pos[3], &sx2, &sy2)) {
            continue
        }
        bh := sy1 - sy2
        if (bh < 0.5 || bh > ScreenH * 2) {
            continue
        }
        bhDraw := Max(bh, 6)
        cxc := (sx1 + sx2) * 0.5
        cyc := (sy1 + sy2) * 0.5
        bw := bhDraw * 0.5
        x1 := cxc - bw / 2, x2 := cxc + bw / 2
        y1 := cyc - bhDraw / 2, y2 := cyc + bhDraw / 2
        dist := 0
        if (IsObject(LocalPlayerPos)) {
            dx := pos[1] - LocalPlayerPos[1]
            dy := pos[2] - LocalPlayerPos[2]
            dz := pos[3] - LocalPlayerPos[3]
            dist := Sqrt(dx * dx + dy * dy + dz * dz)
        }
        distLabel := (dist > 0) ? "  " Round(dist) "m" : ""
        boxPen := hPenBox
        hasCustomPen := false
        isTarget := (AimbotTarget && AimbotTarget.ent = ent)
        if (isTarget) {
            boxPen := RainbowLines ? rainbowPen : hPenTarget
        } else if (ShowTeamColor && ent.team) {
            boxPen := DllCall("gdi32\CreatePen", "Int", 0, "Int", 2, "UInt", ent.team, "Ptr")
            hasCustomPen := true
        }
        if (ShowFill) {
            oldB := DllCall("gdi32\SelectObject", "Ptr", hBBdc, "Ptr", hBrushFill, "Ptr")
            DllCall("gdi32\Rectangle", "Ptr", hBBdc, "Int", Round(x1), "Int", Round(y1)
                , "Int", Round(x2), "Int", Round(y2))
            DllCall("gdi32\SelectObject", "Ptr", hBBdc, "Ptr", oldB, "Ptr")
        }
        if (ShowBox) {
            if (ShowCorner) {
                DrawCornerBox(hBBdc, x1, y1, x2, y2, boxPen)
            } else {
                DrawBox(hBBdc, x1, y1, x2, y2, boxPen)
            }
        }
        if (ShowHealth) {
            barX := x1 - 6, barW := 3
            FillRect(hBBdc, barX, y1, barX + barW, y2, hBrushBgBar)
            pct := (ent.maxhp > 0) ? ent.hp / ent.maxhp : 0
            if (pct > 1) {
                pct := 1
            }
            if (pct < 0) {
                pct := 0
            }
            hpB := (pct > 0.5) ? hBrushHpHigh : (pct > 0.25) ? hBrushHpMid : hBrushHpLow
            barH := (y2 - y1) * pct
            if (barH >= 1) {
                FillRect(hBBdc, barX + 1, y2 - barH, barX + barW - 1, y2, hpB)
            }
        }
        labelText := ""
        if (ShowName) {
            labelText .= ent.name
        }
        if (isTarget) {
            labelText .= " ⌖"
        }
        if (ShowDistance) {
            labelText .= distLabel
        }
        if (labelText != "") {
            DrawText(hBBdc, labelText, Round(cxc - 80), Round(y1 - 18)
                , isTarget ? 0x00FFFF : 0xEEEEEE)
        }
        snapPen := RainbowLines ? rainbowPen : hPenBox
        if (ShowSnaplines && dist > 0) {
            DrawLine(hBBdc, ScreenW / 2, ScreenH, cxc, y2, snapPen)
        }
        if (ShowTracers && dist > 0) {
            DrawLine(hBBdc, ScreenW / 2, 0, cxc, y1, snapPen)
        }
        if (hasCustomPen) {
            DllCall("gdi32\DeleteObject", "Ptr", boxPen, "Ptr")
        }
        drawnCount++
        StatVisible++
    }
}

