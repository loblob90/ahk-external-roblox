; ----------------------------------------------------------------
;  Movement keep-alive — writes only when the value actually drifted
; ----------------------------------------------------------------
MovementKeepAlive() {
    global
    if (!WorldPtr) {
        WorldPtr := mem.Read(WorkspaceAddr + OFF.world, "Ptr")
    }
    if (GravActive && WorldPtr) {
        cur := mem.Read(WorldPtr + OFF.wGrav, "Float")
        if (cur != Float(GravVal)) {
            mem.WriteValue(WorldPtr + OFF.wGrav, Float(GravVal), "Float")
        }
    }
    if (PhysActive && WorldPtr) {
        want := Float(PhysVal) * 4
        if (want < 4) {
            want := 4
        }
        cur := mem.Read(WorldPtr + OFF.wSteps, "Float")
        if (cur != want) {
            mem.WriteValue(WorldPtr + OFF.wSteps, want, "Float")
        }
    }
    if (SpeedActive || JumpActive) {
        ResolveCamHumanoid()
        if (CamHumanoid) {
            if (SpeedActive) {
                cur := mem.Read(CamHumanoid + OFF.walkspd, "Float")
                if (cur != Float(SpeedVal)) {
                    mem.WriteValue(CamHumanoid + OFF.walkspd, Float(SpeedVal), "Float")
                    mem.WriteValue(CamHumanoid + OFF.walkchk, Float(SpeedVal), "Float")
                }
            }
            if (JumpActive) {
                cur := mem.Read(CamHumanoid + OFF.jumppwr, "Float")
                if (cur != Float(JumpVal)) {
                    mem.WriteValue(CamHumanoid + OFF.jumppwr, Float(JumpVal), "Float")
                }
            }
        }
    }
}

; ----------------------------------------------------------------
;  Combat — target selection and aim
; ----------------------------------------------------------------
UpdateCombat() {
    global
    AimbotTarget := 0
    if ((AimbotOn || SilentAimOn) && Attached) {
        AimbotTarget := FindAimbotTarget()
    }
    if (SilentAimOn && Attached) {
        currentLMB := GetKeyState("LButton", "P")
        if (currentLMB && !LastLMB && AimbotTarget) {
            ExecuteCameraAim(AimbotTarget)
        }
        LastLMB := currentLMB
    }
    keyActive := false
    if (AimbotOn && AimbotTarget) {
        keyActive := IsAimKeyActive()
        if (keyActive) {
            StickyTargetChar := AimbotTarget.ent.char
            if (AimType = "Kalman") {
                KalmanStep(AimbotTarget.ent.char, AimbotTarget.sx, AimbotTarget.sy)
                AimbotTarget.sx := KalX
                AimbotTarget.sy := KalY
            }
            if (AimType = "Instant") {
                ; rotation write every frame — no mouse, no sensitivity
                ; gain, no overshoot. crosshair is welded to the head.
                ExecuteCameraAim(AimbotTarget)
            } else {
                ApplyAimbotMovement(AimbotTarget)
            }
        }
    }
    if (!keyActive) {
        EmaDx := 0
        EmaDy := 0
        LastMoveMag := 0
        AimLastTick := 0
        BezierT := 0
        BezierChar := 0
        KalmanReset()
    }
}

IsAimKeyActive() {
    global AimKeyMode, AimMode, AimToggleActive, LastAimKeyState
    if (AimKeyMode = "Always") {
        return true
    }
    keyDown := GetKeyState(AimKeyMode, "P")
    if (AimMode = "Toggle") {
        if (keyDown && !LastAimKeyState) {
            AimToggleActive := !AimToggleActive
        }
        LastAimKeyState := keyDown
        return AimToggleActive
    }
    return keyDown
}

; ---- Kalman filter ----
KalmanReset() {
    global
    KalTargetChar := 0
    KalX := 0, KalVx := 0
    KalY := 0, KalVy := 0
    KalP00x := 0, KalP01x := 0, KalP11x := 0
    KalP00y := 0, KalP01y := 0, KalP11y := 0
    KalLastTick := 0
}

KalmanStep(charPtr, zx, zy) {
    global
    if (KalTargetChar != charPtr) {
        KalTargetChar := charPtr
        KalX := zx, KalVx := 0
        KalY := zy, KalVy := 0
        KalP00x := 400, KalP01x := 0, KalP11x := 500
        KalP00y := 400, KalP01y := 0, KalP11y := 500
        KalLastTick := A_TickCount
        return
    }
    dt := (A_TickCount - KalLastTick) / 1000.0
    KalLastTick := A_TickCount
    if (dt < 0.010) {
        dt := 0.010
    }
    if (dt > 0.100) {
        dt := 0.100
    }
    KalmanAxis(&KalX, &KalVx, &KalP00x, &KalP01x, &KalP11x, zx, dt)
    KalmanAxis(&KalY, &KalVy, &KalP00y, &KalP01y, &KalP11y, zy, dt)
}

KalmanAxis(&x, &v, &p00, &p01, &p11, z, dt) {
    x := x + v * dt
    q00 := KalQ * dt * dt * dt * dt / 4
    q01 := KalQ * dt * dt * dt / 2
    q11 := KalQ * dt * dt
    t00 := p00 + dt * 2 * p01 + dt * dt * p11 + q00
    t01 := p01 + dt * p11 + q01
    t11 := p11 + q11
    p00 := t00, p01 := t01, p11 := t11
    s := p00 + KalR
    k0 := p00 / s
    k1 := p01 / s
    y := z - x
    x := x + k0 * y
    v := v + k1 * y
    p00 := (1 - k0) * p00
    p11 := p11 - k1 * p01
    p01 := (1 - k0) * p01
}

; the point the aimbot chases — real Head part when cached
GetAimPoint(ent) {
    global TargetPart, HeadOffset
    if (TargetPart = "Head" && ent.headPrim) {
        hp := ReadPositionFast(ent.headPrim)
        if (IsObject(hp)) {
            hp[2] += HeadOffset
            return hp
        }
        ent.headPrim := 0
    }
    pos := ReadPositionFast(ent.prim)
    if (!IsObject(pos)) {
        return ""
    }
    switch TargetPart {
        case "Head":
            pos[2] += 2.5 + HeadOffset
        case "Torso":
            pos[2] += 1.0
        case "Nearest":
            pos[2] += 1.5
        default:
            pos[2] += 2.5 + HeadOffset
    }
    return pos
}

FindAimbotTarget() {
    global
    if (!Attached || EntityCache.Length = 0) {
        return 0
    }
    centerX := ScreenW / 2
    centerY := ScreenH / 2
    bestDist := AimbotFOV
    bestTarget := 0
    for ent in EntityCache {
        if (ent.char = LocalCharPtr || !ent.prim || !ent.hum || ent.hum < 0x10000) {
            continue
        }
        if (ent.hp <= 0.01) {
            continue
        }
        aim := GetAimPoint(ent)
        if (!IsObject(aim)) {
            continue
        }
        if (!ProjectToScreen(aim[1], aim[2], aim[3], &sx, &sy)) {
            continue
        }
        dx := sx - centerX
        dy := sy - centerY
        screenDist := Sqrt(dx * dx + dy * dy)
        isSticky := (StickyAimOn && ent.char = StickyTargetChar)
        fovLimit := isSticky ? AimbotFOV * 1.5 : AimbotFOV
        if (screenDist > fovLimit) {
            continue
        }
        if (PredX > 0 || PredY > 0) {
            vel := ReadVelocityFast(ent.prim)
            if (IsObject(vel)) {
                tX := PredX / 1000.0
                tY := PredY / 1000.0
                px := aim[1] + vel[1] * tX
                py := aim[2] + vel[2] * tY
                pz := aim[3] + vel[3] * tX
                if (ProjectToScreen(px, py, pz, &sx, &sy)) {
                    dx := sx - centerX
                    dy := sy - centerY
                    screenDist := Sqrt(dx * dx + dy * dy)
                }
            }
        }
        effectiveDist := isSticky ? screenDist * 0.2 : screenDist
        if (effectiveDist < bestDist) {
            bestDist := effectiveDist
            bestTarget := {ent: ent, sx: sx, sy: sy, dist: screenDist}
        }
    }
    return bestTarget
}

ReadVelocityFast(primPtr) {
    global mem, OFF, VelBuf
    if (!primPtr || primPtr < 0x10000) {
        return ""
    }
    if (!DllCall("ReadProcessMemory", "Ptr", mem.hProcess, "Ptr", primPtr + OFF.pvel
        , "Ptr", VelBuf, "UPtr", 12, "Ptr", 0)) {
        return ""
    }
    x := NumGet(VelBuf, 0, "Float")
    y := NumGet(VelBuf, 4, "Float")
    z := NumGet(VelBuf, 8, "Float")
    if (Abs(x) > 10000 || Abs(y) > 10000 || Abs(z) > 10000) {
        return ""
    }
    return [x, y, z]
}

; ---- mouse-based aim types ----
ApplyAimbotMovement(target) {
    global
    dx := target.sx - ScreenW / 2
    dy := target.sy - ScreenH / 2
    err := Sqrt(dx * dx + dy * dy)
    dt := 1 / 30
    if (AimLastTick) {
        dt := (A_TickCount - AimLastTick) / 1000.0
        if (dt < 0.010) {
            dt := 0.010
        }
        if (dt > 0.100) {
            dt := 0.100
        }
    }
    AimLastTick := A_TickCount
    switch AimType {
        case "Exponential":
            if (err < 2) {
                return
            }
            pow := dt * 30
            ax := 1 - (1 - XSmooth) ** pow
            ay := 1 - (1 - YSmooth) ** pow
            moveX := dx * ax
            moveY := dy * ay
            moveX := Max(-30, Min(30, moveX))
            moveY := Max(-30, Min(30, moveY))
        case "Bezier":
            if (BezierChar != target.ent.char) {
                BezierChar := target.ent.char
                BezierT := 0
            }
            if (BezierT < 1 && err > 4) {
                BezierT := BezierT + XSmooth * (dt * 30)
                if (BezierT > 1) {
                    BezierT := 1
                }
                cx0 := ScreenW / 2, cy0 := ScreenH / 2
                tx := target.sx, ty := target.sy
                dirx := tx - cx0, diry := ty - cy0
                dLen := Sqrt(dirx * dirx + diry * diry)
                if (dLen > 1) {
                    px := -diry / dLen, py := dirx / dLen
                    bow := dLen * 0.35 * BezierSide * (1 - BezierT)
                    mx := (cx0 + tx) / 2 + px * bow
                    my := (cy0 + ty) / 2 + py * bow
                    u := 1 - BezierT
                    bx := u * u * cx0 + 2 * u * BezierT * mx + BezierT * BezierT * tx
                    by := u * u * cy0 + 2 * u * BezierT * my + BezierT * BezierT * ty
                    moveX := bx - cx0
                    moveY := by - cy0
                } else {
                    moveX := dx * XSmooth
                    moveY := dy * YSmooth
                }
            } else {
                moveX := dx * XSmooth
                moveY := dy * YSmooth
            }
            moveX := Max(-30, Min(30, moveX))
            moveY := Max(-30, Min(30, moveY))
        case "Kalman":
            if (err < 2) {
                return
            }
            moveX := dx * XSmooth
            moveY := dy * YSmooth
            moveX := Max(-25, Min(25, moveX))
            moveY := Max(-25, Min(25, moveY))
        case "Smooth":
            if (err < 2) {
                return
            }
            if (err > 25) {
                moveX := dx * XSmooth
                moveY := dy * YSmooth
                moveX := Max(-30, Min(30, moveX))
                moveY := Max(-30, Min(30, moveY))
            } else {
                EmaDx := EmaDx * 0.5 + dx * 0.5
                EmaDy := EmaDy * 0.5 + dy * 0.5
                factor := (LastMoveMag > 8) ? 0.5 : 1.0
                moveX := EmaDx * XSmooth * factor
                moveY := EmaDy * YSmooth * factor
                moveX := Max(-15, Min(15, moveX))
                moveY := Max(-15, Min(15, moveY))
            }
        default: ; Normal
            if (err < 2) {
                return
            }
            moveX := dx * XSmooth
            moveY := dy * YSmooth
            moveX := Max(-30, Min(30, moveX))
            moveY := Max(-30, Min(30, moveY))
    }
    LastMoveMag := Sqrt(moveX * moveX + moveY * moveY)
    DllCall("mouse_event", "UInt", 0x0001, "Int", Round(moveX), "Int", Round(moveY)
        , "UInt", 0, "UInt", 0)
}

ExecuteCameraAim(target) {
    global
    if (!CurrentCamera || !target) {
        return
    }
    aim := GetAimPoint(target.ent)
    if (!IsObject(aim)) {
        return
    }
    tdx := aim[1] - CamX
    tdy := aim[2] - CamY
    tdz := aim[3] - CamZ
    len := Sqrt(tdx * tdx + tdy * tdy + tdz * tdz)
    if (len < 0.001) {
        return
    }
    tdx /= len, tdy /= len, tdz /= len
    zx := -tdx, zy := -tdy, zz := -tdz
    xx := zz, xy := 0.0, xz := -zx
    xLen := Sqrt(xx * xx + xy * xy + xz * xz)
    if (xLen < 0.001) {
        return
    }
    xx /= xLen, xy /= xLen, xz /= xLen
    yx := zy * xz - zz * xy
    yy := zz * xx - zx * xz
    yz := zx * xy - zy * xx
    NumPut("Float", xx, AimRotBuf, 0)
    NumPut("Float", xy, AimRotBuf, 4)
    NumPut("Float", xz, AimRotBuf, 8)
    NumPut("Float", yx, AimRotBuf, 12)
    NumPut("Float", yy, AimRotBuf, 16)
    NumPut("Float", yz, AimRotBuf, 20)
    NumPut("Float", zx, AimRotBuf, 24)
    NumPut("Float", zy, AimRotBuf, 28)
    NumPut("Float", zz, AimRotBuf, 32)
    mem.Write(CurrentCamera + OFF.camRot, AimRotBuf, 36)
}

