; ----------------------------------------------------------------
;  Entity scan rahhhh
; ----------------------------------------------------------------
StartScan() {
    global
    if (!WorkspaceAddr) {
        return
    }
    ScanActive := true
    ScanCursor := 0
    ScanResults := []
    ScanChildren := GetChildren(WorkspaceAddr)
}

ProcessScanChunk() {
    global
    if (!ScanActive) {
        return
    }
    remaining := 5
    while (remaining > 0 && ScanCursor < ScanChildren.Length) {
        ws := ScanChildren[ScanCursor + 1]
        ScanCursor++
        remaining--
        if (!ws) {
            continue
        }
        hum := LocateHumanoid(ws)
        if (hum) {
            ScanResults.Push({char: ws, hum: hum, prim: 0, headPrim: 0, name: "", team: 0})
            continue
        }
        for sub in GetChildren(ws) {
            if (!sub) {
                continue
            }
            hum2 := LocateHumanoid(sub)
            if (hum2) {
                ScanResults.Push({char: sub, hum: hum2, prim: 0, headPrim: 0, name: "", team: 0})
            }
        }
    }
    if (ScanCursor >= ScanChildren.Length) {
        FinishScan()
    }
}

FinishScan() {
    global
    ScanActive := false
    LastScanComplete := A_TickCount
    teamLookup := Map(), charLookup := Map()
    if (PlayersService) {
        for pl in GetChildren(PlayersService) {
            nm := ReadDisplayName(pl)
            if (nm != "?") {
                teamLookup[nm] := mem.Read(pl + OFF.team, "UInt")
                ch := mem.Read(pl + OFF.char, "Ptr")
                if (ch) {
                    charLookup[nm] := ch
                }
            }
        }
    }
    final := [], seen := Map()
    for nm, ch in charLookup {
        if (ch && !seen.Has(ch)) {
            hum := LocateHumanoid(ch)
            if (hum) {
                prim := ResolvePrim(hum, ch)
                headPrim := ResolveHeadPrim(ch)
                seen[ch] := true
                final.Push({char: ch, hum: hum, prim: prim, headPrim: headPrim, name: nm
                    , team: teamLookup[nm]
                    , hp: SafeHp(hum), maxhp: SafeMaxHp(hum)})
            }
        }
    }
    for ent in ScanResults {
        if (seen.Has(ent.char)) {
            continue
        }
        nm := ReadInstanceName(ent.char)
        team := teamLookup.Has(nm) ? teamLookup[nm] : 0
        prim := ResolvePrim(ent.hum, ent.char)
        headPrim := ResolveHeadPrim(ent.char)
        seen[ent.char] := true
        final.Push({char: ent.char, hum: ent.hum, prim: prim, headPrim: headPrim, name: nm
            , team: team
            , hp: SafeHp(ent.hum), maxhp: SafeMaxHp(ent.hum)})
    }
    EntityCache := final
    ScanResults := []
}

SafeHp(hum) {
    global mem, OFF
    return (hum > 0x10000) ? mem.Read(hum + OFF.hp, "Float") : 0
}
SafeMaxHp(hum) {
    global mem, OFF
    return (hum > 0x10000) ? mem.Read(hum + OFF.mhp, "Float") : 0
}

ResolvePrim(hum, charModel) {
    global mem, OFF
    rootPart := mem.Read(hum + OFF.hrp, "Ptr")
    if (rootPart) {
        prim := mem.Read(rootPart + OFF.prim, "Ptr")
        if (prim) {
            testX := mem.Read(prim + OFF.ppos, "Float")
            if (testX != 0 && Abs(testX) < 1000000) {
                return prim
            }
        }
    }
    for child in GetChildren(charModel) {
        if (!child || child = hum) {
            continue
        }
        nm := ReadInstanceName(child)
        if (nm = "Handle" || InStr(nm, "Handle") || InStr(nm, "Tool")) {
            continue
        }
        childPrim := mem.Read(child + OFF.prim, "Ptr")
        if (childPrim) {
            testX := mem.Read(childPrim + OFF.ppos, "Float")
            if (testX != 0 && Abs(testX) < 1000000) {
                return childPrim
            }
        }
    }
    return 0
}

; the literal "Head" part — both R6 and R15 name it that
ResolveHeadPrim(charModel) {
    global mem, OFF
    for child in GetChildren(charModel) {
        if (!child) {
            continue
        }
        if (ReadInstanceName(child) = "Head") {
            prim := mem.Read(child + OFF.prim, "Ptr")
            if (prim) {
                testX := mem.Read(prim + OFF.ppos, "Float")
                if (testX != 0 && Abs(testX) < 1000000) {
                    return prim
                }
            }
        }
    }
    return 0
}

