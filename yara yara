;  Memory reads
; ----------------------------------------------------------------
ReadPositionFast(primPtr) {
    global mem, OFF, ReadPosBuf
    if (!primPtr || primPtr < 0x10000) {
        return ""
    }
    if (!DllCall("ReadProcessMemory", "Ptr", mem.hProcess, "Ptr", primPtr + OFF.ppos
        , "Ptr", ReadPosBuf, "UPtr", 12, "Ptr", 0)) {
        return ""
    }
    x := NumGet(ReadPosBuf, 0, "Float")
    y := NumGet(ReadPosBuf, 4, "Float")
    z := NumGet(ReadPosBuf, 8, "Float")
    if (x = 0 && y = 0 && z = 0) {
        return ""
    }
    if (Abs(x) > 1000000 || Abs(y) > 1000000 || Abs(z) > 1000000) {
        return ""
    }
    return [x, y, z]
}

ResolveLocalPlayer() {
    global
    LocalCharPtr := 0, LocalPrimPtr := 0, LocalHumPtr := 0, LocalHeadPrim := 0
    LocalPlayerPos := ""
    if (!PlayersService) {
        return
    }
    lp := mem.Read(PlayersService + OFF.lp, "Ptr")
    if (!lp) {
        return
    }
    LocalCharPtr := mem.Read(lp + OFF.char, "Ptr")
    if (!LocalCharPtr) {
        lpName := ReadDisplayName(lp)
        for ent in EntityCache {
            if (ent.name = lpName) {
                LocalCharPtr := ent.char
                LocalHumPtr := ent.hum
                LocalPrimPtr := ent.prim
                LocalHeadPrim := ent.headPrim
                break
            }
        }
    }
    if (LocalCharPtr) {
        if (!LocalHumPtr) {
            LocalHumPtr := LocateHumanoid(LocalCharPtr)
        }
        if (LocalHumPtr && !LocalPrimPtr) {
            LocalPrimPtr := ResolvePrim(LocalHumPtr, LocalCharPtr)
        }
        if (!LocalHeadPrim) {
            LocalHeadPrim := ResolveHeadPrim(LocalCharPtr)
        }
        if (LocalPrimPtr) {
            p := ReadPositionFast(LocalPrimPtr)
            if (IsObject(p)) {
                LocalPlayerPos := p
            }
        }
    }
}

LocateHumanoid(charModel) {
    global mem, OFF
    children := GetChildren(charModel)
    for child in children {
        if (!child) {
            continue
        }
        if (ReadInstanceName(child) = "Humanoid") {
            return child
        }
    }
    for child in children {
        if (!child) {
            continue
        }
        mh := mem.Read(child + OFF.mhp, "Float")
        if (mh < 1 || mh > 100000) {
            continue
        }
        hp := mem.Read(child + OFF.hp, "Float")
        if (hp < 0 || hp > mh + 2) {
            continue
        }
        root := mem.Read(child + OFF.hrp, "Ptr")
        if (root && mem.Read(root + OFF.prim, "Ptr")) {
            return child
        }
    }
    return 0
}

; ----------------------------------------------------------------
;  Projection
; ----------------------------------------------------------------
LoadViewMatrix(veAddr) {
    global ViewM, mem, OFF
    ViewM := []
    mbuf := Buffer(64, 0)
    if (!DllCall("ReadProcessMemory", "Ptr", mem.hProcess, "Ptr", veAddr + OFF.mat
        , "Ptr", mbuf, "UPtr", 64, "Ptr", 0)) {
        return false
    }
    hasData := false
    Loop 16 {
        v := NumGet(mbuf, (A_Index - 1) * 4, "Float")
        ViewM.Push(v)
        if (v != 0) {
            hasData := true
        }
    }
    return hasData
}

ProjectToScreen(px, py, pz, &sx, &sy) {
    global ViewM, MatrixMode, ScreenW, ScreenH
    if (MatrixMode = "ROW") {
        w := ViewM[13] * px + ViewM[14] * py + ViewM[15] * pz + ViewM[16]
        if (w < 0.1) {
            return false
        }
        cx := (ViewM[1] * px + ViewM[2] * py + ViewM[3] * pz + ViewM[4]) / w
        cy := (ViewM[5] * px + ViewM[6] * py + ViewM[7] * pz + ViewM[8]) / w
    } else {
        w := ViewM[4] * px + ViewM[8] * py + ViewM[12] * pz + ViewM[16]
        if (w < 0.1) {
            return false
        }
        cx := (ViewM[1] * px + ViewM[5] * py + ViewM[9] * pz + ViewM[13]) / w
        cy := (ViewM[2] * px + ViewM[6] * py + ViewM[10] * pz + ViewM[14]) / w
    }
    sx := (cx + 1) * 0.5 * ScreenW
    sy := (1 - cy) * 0.5 * ScreenH
    return true
}

; ----------------------------------------------------------------
;  Roblox instance tree
; ----------------------------------------------------------------
FindService(name) {
    global DataModel
    for child in GetChildren(DataModel) {
        if (ReadInstanceName(child) = name) {
            return child
        }
    }
    return 0
}

GetChildren(instance) {
    global mem, OFF
    result := []
    if (!instance) {
        return result
    }
    p1 := mem.Read(instance + OFF.child, "Ptr")
    if (!p1) {
        return result
    }
    begin := 0, endp := 0
    b := mem.Read(p1, "Ptr")
    if (b) {
        e := mem.Read(p1 + OFF.childEnd, "Ptr")
        if (e && e > b && (e - b) <= 0x20000 && Mod(e - b, 8) = 0) {
            begin := b, endp := e
        }
    }
    if (!begin) {
        e := mem.Read(instance + OFF.child + 0x8, "Ptr")
        if (e && e > p1 && (e - p1) <= 0x20000 && Mod(e - p1, 8) = 0) {
            begin := p1, endp := e
        }
    }
    if (!begin) {
        return result
    }
    count := (endp - begin) // 8
    if (count > 3000) {
        count := 3000
    }
    Loop count {
        c := mem.Read(begin + (A_Index - 1) * 8, "Ptr")
        if (c) {
            result.Push(c)
        }
    }
    return result
}

ReadInstanceName(instance) {
    global mem, OFF
    container := mem.Read(instance + OFF.nameC, "Ptr")
    if (!container) {
        return ""
    }
    s := ReadRobloxString(container + OFF.name, 64)
    return (s = "") ? ReadRobloxString(container, 64) : s
}

ReadDisplayName(player) {
    global mem, OFF
    s := ReadRobloxString(player + OFF.disp, 32)
    if (s = "") {
        s := ReadInstanceName(player)
    }
    return (s = "") ? "?" : s
}

ReadRobloxString(addr, maxLen := 64) {
    global mem
    if (!addr) {
        return ""
    }
    len := mem.Read(addr + 0x10, "UInt")
    if (len = "" || len > maxLen) {
        return ""
    }
    if (len <= 15) {
        return mem.ReadString(addr, len)
    }
    dataPtr := mem.Read(addr, "Ptr")
    if (!dataPtr) {
        return ""
    }
    return mem.ReadString(dataPtr, len)
}

; ----------------------------------------------------------------
;  Debug output
; ----------------------------------------------------------------
EntityReport() {
    global
    if (!RequireAttach()) {
        MsgBox("Not attached")
        return
    }
    out := "VORTEX Report`nTotal: " EntityCache.Length "`n`n"
    nVis := 0, nOff := 0, nDead := 0
    for i, ent in EntityCache {
        if (ent.char = LocalCharPtr) {
            out .= i ". " ent.name " — Local`n"
            continue
        }
        if (!ent.hum || ent.hp <= 0.01) {
            out .= i ". " ent.name " — Dead`n"
            nDead++
            continue
        }
        if (!ent.prim) {
            out .= i ". " ent.name " — No pos`n"
            continue
        }
        aim := GetAimPoint(ent)
        if (!IsObject(aim)) {
            out .= i ". " ent.name " — Stale`n"
            continue
        }
        if (!ProjectToScreen(aim[1], aim[2], aim[3], &sx, &sy)) {
            out .= i ". " ent.name " — Off-screen`n"
            nOff++
            continue
        }
        out .= i ". " ent.name " — Visible (head: " (ent.headPrim ? "yes" : "offset") ")`n"
        nVis++
    }
    out .= "`nVis: " nVis " | Off: " nOff " | Dead: " nDead
    Clipboard := out
    MsgBox(out, "VORTEX")
}

DebugDump() {
    global
    if (!RequireAttach()) {
        MsgBox("Not attached")
        return
    }
    heads := 0
    for ent in EntityCache {
        if (ent.headPrim) {
            heads++
        }
    }
    m := "VORTEX`n`n"
    m .= "Offsets: " OffsetSource "`n"
    m .= "Matrix: " MatrixMode " (" (MatrixOK ? "OK" : "FAIL") ")`n"
    m .= "Entities: " EntityCache.Length " (" heads " with real Head part)`n"
    m .= "AimType: " AimType " | FOV: " AimbotFOV "`n"
    m .= "X: " XSmooth " | Y: " YSmooth "`n"
    m .= "Pred X: " PredX "ms | Pred Y: " PredY "ms`n"
    m .= "Head ±: " HeadOffset " studs`n"
    m .= "Sticky: " StickyTargetChar "`n"
    MsgBox(m, "VORTEX")
}

