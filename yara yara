; ----------------------------------------------------------------
;  Offsets — live fetch, then offsets.txt, then defaults
; ----------------------------------------------------------------
global OFFSET_URL := "https://offsets.imtheo.lol/"
global OffsetSource := "built-in defaults"

global OFF := LoadOffsets()

LoadOffsets() {
    global OFFSET_URL, OffsetSource
    content := ""
    if (OFFSET_URL != "") {
        content := HttpGet(OFFSET_URL)
        if (content != "" && !InStr(content, "namespace Offsets")) {
            content := ""
        }
    }
    if (content = "" && FileExist(A_ScriptDir "\offsets.txt")) {
        try content := FileRead(A_ScriptDir "\offsets.txt", "UTF-8")
        if (content != "" && !InStr(content, "namespace Offsets")) {
            content := ""
        } else if (content != "") {
            OffsetSource := "offsets.txt"
        }
    }
    defaults := DefaultOffsets()
    if (content = "") {
        return defaults
    }
    parsed := ParseTheoHeader(content)
    if (parsed.Count = 0) {
        OffsetSource := "built-in defaults (parse failed)"
        return defaults
    }
    if (RegExMatch(content, 'ClientVersion\s*=\s*"([^"]+)"', &cv)) {
        OffsetSource := "live — " cv[1]
    }
    off := {}
    missing := []
    for short, full in AliasMap().OwnProps() {
        if (parsed.Has(full)) {
            off.%short% := parsed[full]
        } else {
            off.%short% := defaults.%short%
            missing.Push(full)
        }
    }
    if (missing.Length > 0) {
        OffsetSource .= " (" missing.Length " fell back)"
    }
    return off
}

HttpGet(url) {
    try {
        http := ComObject("WinHttp.WinHttpRequest.5.1")
        http.SetTimeouts(10000, 10000, 10000, 10000)
        http.Open("GET", url, false)
        http.Send()
        if (http.Status = 200) {
            return http.ResponseText
        }
    } catch {
    }
    return ""
}

ParseTheoHeader(content) {
    out := Map()
    ns := ""
    Loop Parse content, "`n", "`r"
    {
        line := Trim(A_LoopField)
        if (RegExMatch(line, "^namespace\s+(\w+)", &m)) {
            ns := m[1]
            continue
        }
        if (RegExMatch(line, "^inline\s+constexpr\s+uintptr_t\s+(\w+)\s*=\s*(0x[0-9a-fA-F]+)", &e)) {
            if (ns != "" && ns != "Offsets") {
                out[ns "." e[1]] := e[2] + 0
            }
        }
    }
    return out
}

