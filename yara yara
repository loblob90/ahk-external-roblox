global RainbowPens := []
Loop 24 {
    h := (A_Index - 1) * 15
    sec := Mod(h, 360) / 60
    i := Floor(sec), f := sec - i
    v := 255, p := 0, q := Round(v * (1 - f)), t := Round(v * f)
    if (i = 0) {
        r := v, g := t, b := p
    } else if (i = 1) {
        r := q, g := v, b := p
    } else if (i = 2) {
        r := p, g := v, b := t
    } else if (i = 3) {
        r := p, g := q, b := v
    } else if (i = 4) {
        r := t, g := p, b := v
    } else {
        r := v, g := p, b := q
    }
    RainbowPens.Push(DllCall("gdi32\CreatePen", "Int", 0, "Int", 2, "UInt", (b << 16) | (g << 8) | r, "Ptr"))
}
